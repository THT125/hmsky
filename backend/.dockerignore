# 环境配置(含密钥,永不进镜像)
.env
.env.*.local

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# 测试与开发产物(镜像不需要)
tests/
smoke_test.py
ws_test*.py
gen_images.py

# 日志
*.log

# 本地上传文件(运行时可挂 volume)
static/uploads/

# 迁移缓存
alembic/versions/__pycache__/

# ⚠️ 注意:data/ 目录**不要排除**
# 里面是 ip2region 离线 IP 库(ip2region_v4.xdb,约 10MB),管理端的 IP 归属地功能依赖它。
# 排除了不会报错,只是归属地全部显示为空(代码里有降级),容易被忽略。
