# ===== 环境配置模板 =====
# 用法: 复制本文件为 .env 并填入真实值
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env  (Windows)
# 注意: .env 含敏感信息,已被 .gitignore 排除,永不提交;本模板可以提交

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=sky-take-out-master-cg

# ===== JWT =====
# 强随机密钥,生产环境必须重新生成:
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_KEY=replace_with_random_hex_64_chars
ADMIN_TTL=7200000
ADMIN_TOKEN_NAME=token
# 用户端
USER_SECRET_KEY=replace_with_random_hex_64_chars
USER_TTL=7200000
USER_TOKEN_NAME=authentication

# ===== 店铺配送(百度地图,ak 为空则跳过配送距离校验)=====
BAIDU_AK=
SHOP_LNG=116.34
SHOP_LAT=40.00
LIMIT_DISTANCE=5.0

# ===== 阿里云 OSS(access-key-id 为空则存本地 static 目录)=====
ALIOSS_ACCESS_KEY_ID=
ALIOSS_ACCESS_KEY_SECRET=
ALIOSS_BUCKET_NAME=
ALIOSS_ENDPOINT=
ALIOSS_REGION=

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password

# ===== 安全(登录)=====
# 图形验证码: 1 开启(生产), 0 关闭且接口返回验证码明文(测试/本地联调)
CAPTCHA_ENABLED=1
# 登录失败锁定: 连续失败次数 / 锁定分钟数
LOGIN_FAIL_MAX=5
LOGIN_FAIL_LOCK_MINUTES=10

# ===== 短信验证码(手机号登录;SMS_ENABLED=0 时验证码固定 123456)=====
SMS_ENABLED=0
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN_NAME=苍穹外卖

# ===== 调试 =====
# SQL 日志开关: 1 打印 SQL 语句(便于调试), 0 关闭
DB_ECHO=0

# ===== 服务 =====
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
